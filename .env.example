VITE_API_URL=https://localhost:7009

# Token público de Mapbox (empieza con "pk."). Se obtiene en
# https://account.mapbox.com/access-tokens — es un token PÚBLICO por diseño, pensado para
# viajar en el bundle del frontend (a diferencia de un connection string o una API key
# privada), así que no hay problema de seguridad en que quede visible ahí. Igual conviene
# restringirlo por dominio desde el dashboard de Mapbox antes de producción.
VITE_MAPBOX_TOKEN=
